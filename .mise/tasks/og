#!/usr/bin/env python3
#MISE description="After `zola build`: draw a 1200x630 social card per page into public/og/"
"""
Every page carries its card data as <script id="og-card"> (themes/seijaku/templates/partials/og_card.html),
and its og:image already points at og/<path>.png. This fills og/card.html with that data and screenshots it
with headless Chrome, for each page whose og:image is a generated card (pages with a hand-made og_image are
skipped). Nothing is committed: the cards are built in CI like llms.txt and map.json.

Needs Chrome or Chromium; set CHROME to its path if it is not found.
  mise run og                 all pages
  mise run og articles/foo    one page (path below public/)

With OG_CACHE set to a directory, a card is only drawn when its fingerprint is new: a hash of the card data, the
cover image, the template, the logo and the fonts. Unchanged cards are copied from the cache, and the cache is
pruned to the cards of this build. CI keeps the directory between runs (actions/cache).
"""
import concurrent.futures
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
PUBLIC = os.path.join(ROOT, "public")
OUT = os.path.join(PUBLIC, "og")
# Attribute order and quoting vary once the HTML is minified.
CARD_RE = re.compile(r'<script[^>]*\bid="?og-card"?[^>]*>(.*?)</script>', re.S)
IMAGE_RE = re.compile(r'<meta (?=[^>]*\bproperty="?og:image"?[ >])[^>]*\bcontent="?([^" >]+)')


def find_chrome():
    candidates = [os.environ.get("CHROME"), "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
                  shutil.which("google-chrome"), shutil.which("google-chrome-stable"), shutil.which("chromium"),
                  shutil.which("chromium-browser")]
    for c in candidates:
        if c and os.path.exists(c):
            return c
    sys.exit("og: no Chrome found; set CHROME")


def local(url):
    """https://raskell.io/covers/x.avif -> file:///.../public/covers/x.avif"""
    return "file://" + os.path.join(PUBLIC, re.sub(r"^https?://[^/]+/", "", url))


def pages(only):
    for dirpath, _, files in os.walk(PUBLIC):
        if "index.html" not in files or dirpath.startswith(OUT):
            continue
        rel = os.path.relpath(dirpath, PUBLIC)
        name = "index" if rel == "." else rel
        if only and name not in only:
            continue
        doc = open(os.path.join(dirpath, "index.html"), encoding="utf-8").read()
        card, image = CARD_RE.search(doc), IMAGE_RE.search(doc)
        # Only pages whose og:image is this generated card; a hand-made og_image wins and needs nothing.
        if card and image and html.unescape(image.group(1)).endswith("/og/%s.png" % name):
            yield name, json.loads(card.group(1))


def main():
    only = set(a.strip("/") for a in sys.argv[1:])
    chrome = find_chrome()
    template = open(os.path.join(ROOT, "og", "card.html"), encoding="utf-8").read()
    mark = open(os.path.join(ROOT, "static", "images", "raskell-mark.svg"), encoding="utf-8").read()
    mark = mark.replace("__id__", "og-mark")
    work = tempfile.mkdtemp(prefix="og-")
    cache = os.environ.get("OG_CACHE")
    if cache:
        os.makedirs(cache, exist_ok=True)
    # What every card depends on besides its own data: the template, the logo, and the fonts it loads.
    base = hashlib.sha256(template.encode() + mark.encode())
    fonts = os.path.join(PUBLIC, "fonts")
    for f in sorted(os.listdir(fonts)) if os.path.isdir(fonts) else []:
        base.update(f.encode() + open(os.path.join(fonts, f), "rb").read())
    jobs, cached, keep = [], 0, set()
    for name, card in pages(only):
        if card.get("cover"):
            card["cover"] = local(card["cover"])
        dest = os.path.join(OUT, name + ".png")
        fp = None
        if cache:
            h = base.copy()
            h.update(json.dumps(card, sort_keys=True, ensure_ascii=False).encode())
            cover_file = card["cover"][len("file://"):] if card.get("cover") else ""
            if cover_file and os.path.exists(cover_file):
                h.update(open(cover_file, "rb").read())
            fp = h.hexdigest()
            keep.add(fp + ".png")
            hit = os.path.join(cache, fp + ".png")
            if os.path.exists(hit):
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                shutil.copyfile(hit, dest)
                cached += 1
                continue
        page = (template.replace("__PUBLIC__", "file://" + PUBLIC).replace("__MARK__", mark)
                .replace("__CARD__", json.dumps(card).replace("</", "<\\/")))
        src = os.path.join(work, name.replace("/", "__") + ".html")
        open(src, "w", encoding="utf-8").write(page)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        jobs.append((src, dest, fp))

    def shoot(job):
        src, dest, fp = job
        profile = tempfile.mkdtemp(dir=work)
        # Ubuntu 24.04 runners block the user namespaces Chrome's sandbox needs; the pages are our own local files.
        sandbox = ["--no-sandbox"] if sys.platform.startswith("linux") else []
        subprocess.run([chrome, *sandbox, "--headless=new", "--disable-gpu", "--hide-scrollbars", "--no-first-run",
                        "--allow-file-access-from-files", "--force-device-scale-factor=1",
                        "--user-data-dir=" + profile, "--window-size=1200,630", "--virtual-time-budget=4000",
                        "--screenshot=" + dest, "file://" + src],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
        if cache and fp:
            shutil.copyfile(dest, os.path.join(cache, fp + ".png"))
        return dest

    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, os.cpu_count() or 2)) as pool:
        done = list(pool.map(shoot, jobs))
    shutil.rmtree(work, ignore_errors=True)
    # Prune: the cache holds exactly this build's cards (only after a full run, not a single page).
    if cache and not only:
        for f in os.listdir(cache):
            if f.endswith(".png") and f not in keep:
                os.remove(os.path.join(cache, f))
    print("og: %d cards in public/og/ (%d drawn, %d from the cache)" % (len(done) + cached, len(done), cached))


if __name__ == "__main__":
    main()
