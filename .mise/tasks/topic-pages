#!/usr/bin/env python3
#MISE description="Write one topic page per topic for every translated language (content/taxonomy-tags-<slug>.<lang>.md, gitignored)"
"""
Zola builds taxonomies per language, so /zh/tags/<slug>/ would not exist while the writing is in English.
This writes, for every language in config (extra.seijaku.languages) other than the default and every topic
in data/tags.toml, a small page at /<lang>/tags/<slug>/ that renders the English topic in that language
(theme template taxonomy_index.html), titled with its translation from data/tags.<lang>.toml when there is
one. The files are build artefacts (gitignored); CI runs this before `zola build`, and so must you locally
after changing the vocabulary or its translations. Standard library only.
"""
import glob
import os
import re

os.chdir(os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")))
config = open("config.toml").read()
default = (re.search(r'^default_language\s*=\s*"([^"]+)"', config, re.M) or [None, "en"])[1]
langs = [c for c in re.findall(r'^\s*\{ code = "([a-z-]+)"', config, re.M) if c != default]

def entries(path):
    """slug -> {name, description} from a vocabulary file (a small TOML reader for this one shape)."""
    out, cur = {}, None
    if not os.path.exists(path):
        return out
    for line in open(path):
        m = re.match(r"^\[([a-z0-9-]+)\]\s*$", line)
        if m:
            cur = m.group(1); out[cur] = {}
            continue
        m = re.match(r'^(name|description)\s*=\s*"((?:[^"\\]|\\.)*)"\s*$', line)
        if cur and m:
            out[cur][m.group(1)] = m.group(2)
    return out

vocab = entries("data/tags.toml")
for old in glob.glob("content/taxonomy-tags-*.md"):
    os.remove(old)
n = 0
for lang in langs:
    tr = entries("data/tags.%s.toml" % lang)
    for slug, en in vocab.items():
        t = tr.get(slug, {})
        with open("content/taxonomy-tags-%s.%s.md" % (slug, lang), "w") as f:
            f.write('+++\ntitle = "%s"\ndescription = "%s"\npath = "%s/tags/%s"\ntemplate = "taxonomy_index.html"\n\n'
                    '# Generated by `mise run topic-pages` from data/tags.toml and data/tags.%s.toml; do not edit.\n'
                    '[extra]\ntaxonomy = "tags"\nterm = "%s"\n+++\n'
                    % (t.get("name") or en.get("name", slug), t.get("description") or en.get("description", ""), lang, slug, lang, slug))
        n += 1
print("topic-pages: %d pages for %s" % (n, ", ".join(langs) or "no translated languages"))
