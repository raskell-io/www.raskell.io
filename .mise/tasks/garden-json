#!/usr/bin/env python3
#MISE description="After `zola build`: publish the search index as public/garden.json and the cited links as public/links.json"
"""
The search page carries the whole garden as inline JSON (the theme's partials/garden_data.html): every
article, review, note, talk, work from the reading log, project, topic, and external link the pages cite.
This publishes it for agents and answer engines that do not run the page:

  public/garden.json   every item, with its kind, title, URL, description, date, topics, and categories
  public/links.json    every external link the writing cites, merged by URL, with the pages citing it,
                       whether it sits under a References heading, and its domain

The same merge rules as the search script (static/seijaku-search.js): links match without a trailing
slash, and a project listed on both the projects and the apps page is one item.
"""
import datetime
import json
import os
import re
from urllib.parse import urlparse

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
PUBLIC = os.path.join(ROOT, "public")
html = open(os.path.join(PUBLIC, "search", "index.html"), encoding="utf-8").read()
rows = [r for r in json.loads(re.search(r'id="?garden-data"?[^>]*>(.*?)</script>', html, re.S).group(1))["items"] if r]
now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
LICENSE = "https://creativecommons.org/licenses/by/4.0/"
KINDS = {"article": "article", "note": "note", "talk": "talk", "work": "work", "project": "project", "topic": "topic"}

items, seen, links = [], set(), {}
for r in rows:
    if r["k"] == "link":
        key = r["u"].rstrip("/").replace("http://", "https://", 1)
        text = re.split(r"\n\s*\n|\n {4,}", (r.get("t") or "").strip())[0]
        text = re.sub(r"\s+", " ", text).strip()
        link = links.setdefault(key, {"url": r["u"], "title": "", "domain": urlparse(r["u"]).netloc.removeprefix("www."),
                                      "reference": False, "cited_in": []})
        if text and not text.startswith("http") and len(text) > len(link["title"]):
            link["title"] = text if len(text) <= 120 else text[:117].rsplit(" ", 1)[0] + "…"
        link["reference"] = link["reference"] or bool(r.get("r"))
        if not any(c["url"] == r["p"] for c in link["cited_in"]):
            link["cited_in"].append({"title": r["pt"], "url": r["p"]})
        continue
    if (r["k"], r["u"]) in seen:
        continue
    seen.add((r["k"], r["u"]))
    kind = "review" if r["k"] == "article" and "reviews" in r.get("c", []) else KINDS[r["k"]]
    item = {"kind": kind, "title": r["t"], "url": r["u"], "description": r.get("d") or None, "date": r.get("y") or None,
            "topics": r.get("g") or None, "categories": r.get("c") or None, "meta": r.get("m") or None}
    items.append({k: v for k, v in item.items() if v})

link_list = sorted(links.values(), key=lambda l: (-len(l["cited_in"]), l["url"]))
for l in link_list:
    l["title"] = l["title"] or l["url"]
    l["citations"] = len(l["cited_in"])

counts = {}
for i in items:
    counts[i["kind"]] = counts.get(i["kind"], 0) + 1
counts["link"] = len(link_list)

garden = {
    "source": "https://raskell.io/search/",
    "generated": now,
    "description": "Everything on raskell.io as one index: articles, reviews, notes, talks, works from the reading log, "
                   "projects, topics, and every external link the writing cites. The same index the site's search uses.",
    "license": LICENSE,
    "counts": counts,
    "search_url": "https://raskell.io/search/?q={query}&type={kind}",
    "related": {"graph": "https://raskell.io/map.json", "links": "https://raskell.io/links.json",
                "reading": "https://raskell.io/reading.json", "llms": "https://raskell.io/llms.txt"},
    "items": items + [{"kind": "link", "title": l["title"], "url": l["url"], "domain": l["domain"], "reference": l["reference"],
                       "cited_in": l["cited_in"]} for l in link_list],
}
links_doc = {
    "source": "https://raskell.io/search/?type=link",
    "generated": now,
    "description": "Every external link cited on raskell.io, merged by URL, most-cited first: where it is cited, and whether "
                   "it is listed as a reference.",
    "count": len(link_list),
    "links": link_list,
}
with open(os.path.join(PUBLIC, "garden.json"), "w", encoding="utf-8") as f:
    json.dump(garden, f, indent=1, ensure_ascii=False)
with open(os.path.join(PUBLIC, "links.json"), "w", encoding="utf-8") as f:
    json.dump(links_doc, f, indent=1, ensure_ascii=False)
print("garden.json: %s; links.json: %d links" % (", ".join("%d %s" % (n, k) for k, n in sorted(counts.items())), len(link_list)))
