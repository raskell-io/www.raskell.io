#!/usr/bin/env python3
#MISE description="Write static/.well-known/security.txt (RFC 9116) with Expires one year from today"
"""
RFC 9116 requires an Expires field, and an expired security.txt is treated as absent. CI runs this
before every build, and the deploy workflow also runs monthly on a schedule, so the date never lapses
even when nothing is published for a while. The file is a build artefact (gitignored).
"""
import datetime
import os

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
expires = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(days=365)).replace(microsecond=0)
body = """# Security contact for raskell.io (RFC 9116). Generated by `mise run security-txt`; do not edit.
Contact: https://github.com/raskell-io/www.raskell.io/security/advisories/new
Contact: https://raskell.io/about/#contact
Expires: %s
Preferred-Languages: en, de
Canonical: https://raskell.io/.well-known/security.txt
""" % expires.strftime("%Y-%m-%dT%H:%M:%SZ")
path = os.path.join(ROOT, "static", ".well-known", "security.txt")
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, "w").write(body)
print("security.txt: expires %s" % expires.date().isoformat())
