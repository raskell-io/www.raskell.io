#!/usr/bin/env python3
#MISE description="Check that every tag in content/, project topics, and the reading log is defined in data/tags.toml; validate the reading log"
"""
The topic vocabulary in data/tags.toml is the source of truth for tags. This reports:
  - tags used in content/ or data/projects/*.toml that the vocabulary does not define (an error),
  - broader references that point at undefined tags (an error),
  - vocabulary entries nothing uses yet (a note, not an error: the graph still shows them).
Exit status 1 when there is an error, so CI or a pre-commit hook can use it.
  - translations of the vocabulary (data/tags.<lang>.toml) with slugs it does not define (an error),
    and topics they do not translate yet (a note).
"""
import glob
import os
import re
import sys

os.chdir(os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")))
vocab, broader, cur = {}, {}, None
for line in open("data/tags.toml"):
    m = re.match(r"^\[([a-z0-9-]+)\]\s*$", line)
    if m:
        cur = m.group(1); vocab[cur] = True; broader[cur] = []
    m = re.match(r"^broader\s*=\s*\[(.*)\]", line)
    if cur and m:
        broader[cur] = re.findall(r'"([^"]+)"', m.group(1))

used = {}
for path in glob.glob("content/**/*.md", recursive=True):
    m = re.search(r"^tags\s*=\s*\[(.*?)\]", open(path).read(), re.M)
    for t in re.findall(r'"([^"]+)"', m.group(1)) if m else []:
        used.setdefault(t, []).append(path)
for path in glob.glob("data/projects/*.toml"):
    m = re.search(r"^topics\s*=\s*\[(.*?)\]", open(path).read(), re.M)
    for t in re.findall(r'"([^"]+)"', m.group(1)) if m else []:
        used.setdefault(t, []).append(path)

errors = 0

# The reading log: topics count as uses; each entry needs its fields, a known status and kind, and a
# unique id; reviews (extra.review) and mentions (extra.reads) in content must name an entry.
works = {}
if os.path.exists("data/reading.toml"):
    for block in re.split(r"^\[\[works\]\]\s*$", open("data/reading.toml").read(), flags=re.M)[1:]:
        field = lambda k: (re.search(r'^%s\s*=\s*"([^"]*)"' % k, block, re.M) or [None, None])[1]
        wid = field("id") or "?"
        m = re.search(r"^topics\s*=\s*\[(.*?)\]", block, re.M)
        for t in re.findall(r'"([^"]+)"', m.group(1)) if m else []:
            used.setdefault(t, []).append("data/reading.toml (%s)" % wid)
        problems = ["missing %s" % k for k in ("id", "title", "author", "kind", "status") if not field(k)]
        if field("status") and field("status") not in ("reading", "next", "backlog", "read", "set-aside"):
            problems.append("unknown status %s" % field("status"))
        if field("kind") and field("kind") not in ("book", "novel", "paper", "report", "article", "essay", "journal"):
            problems.append("unknown kind %s" % field("kind"))
        if field("status") == "read" and not field("finished"):
            problems.append("read without finished")
        for k in ("started", "finished"):
            if field(k) and not re.match(r"^\d{4}(-(0[1-9]|1[0-2]))?$", field(k)):
                problems.append("%s is not a month (YYYY-MM) or a year (YYYY)" % k)
        m = re.search(r"^rating\s*=\s*(\S+)", block, re.M)
        if m and not (re.match(r"^\d+(\.5)?$", m.group(1)) and 1 <= float(m.group(1)) <= 10):
            problems.append("rating is not a number from 1 to 10 in half steps")
        if wid in works:
            problems.append("duplicate id")
        works[wid] = True
        for p in problems:
            errors += 1
            print("reading %-24s %s" % (wid, p))
    for path in glob.glob("content/**/*.md", recursive=True):
        text = open(path).read()
        refs = re.findall(r'^review\s*=\s*"([^"]+)"', text, re.M)
        m = re.search(r"^reads\s*=\s*\[(.*?)\]", text, re.M | re.S)
        refs += re.findall(r'"([^"]+)"', m.group(1)) if m else []
        for r in refs:
            if r not in works:
                errors += 1
                print("unknown work %-21s named in %s" % (r, path))

# Categories: each one used must be described in config (categories_descriptions), and a page is in
# "reviews" exactly when it reviews a work (extra.review).
config = open("config.toml").read()
m = re.search(r"^categories_descriptions\s*=\s*\{(.*?)\}\s*$", config, re.M)
described = set(re.findall(r'"([a-z0-9-]+)"\s*=', m.group(1))) if m else set()
for path in glob.glob("content/**/*.md", recursive=True):
    text = open(path).read()
    m = re.search(r"^categories\s*=\s*\[(.*?)\]", text, re.M)
    cats = re.findall(r'"([^"]+)"', m.group(1)) if m else []
    for c in cats:
        if c not in described:
            errors += 1
            print("undefined category %-16s used in %s (describe it in config.toml categories_descriptions)" % (c, path))
    reviews = bool(re.search(r'^review\s*=\s*"', text, re.M))
    if reviews != ("reviews" in cats) and not re.search(r"^draft\s*=\s*true", text, re.M):
        errors += 1
        print("%s: %s" % (path, "reviews a work but is not in the reviews category" if reviews else "in the reviews category without extra.review"))

for t, where in sorted(used.items()):
    if t not in vocab:
        errors += 1
        print("undefined tag %-22s used in %s" % (t, ", ".join(sorted(set(where)))))
for t, bs in broader.items():
    for b in bs:
        if b not in vocab:
            errors += 1
            print("undefined broader %-18s on %s" % (b, t))
unused = sorted(t for t in vocab if t not in used)
if unused:
    print("defined but unused (shown on the map without pages): " + ", ".join(unused))
# Translations of the vocabulary (data/tags.<lang>.toml, keyed by the same slugs): a slug the vocabulary does
# not define is an error; a topic with no translation is a note (it shows in English in that language).
for path in sorted(glob.glob("data/tags.*.toml")):
    tr = [m.group(1) for m in (re.match(r"^\[([a-z0-9-]+)\]\s*$", l) for l in open(path)) if m]
    for slug in tr:
        if slug not in vocab:
            print("%s: [%s] is not in data/tags.toml" % (path, slug)); errors += 1
    missing = [s for s in vocab if s not in tr]
    if missing:
        print("%s: no translation yet for %s" % (path, ", ".join(missing)))

print("tags-check: %d defined, %d used, %d errors" % (len(vocab), len(used), errors))
sys.exit(1 if errors else 0)
