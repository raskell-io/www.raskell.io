          "- Feeds: [RSS](%s/rss.xml), [Atom](%s/atom.xml), [articles](%s/articles/rss.xml), [notes](%s/notes/rss.xml), [reviews](%s/categories/reviews/rss.xml), [talks](%s/talks/rss.xml)" % (BASE, BASE, BASE, BASE, BASE, BASE),
          "- In the browser: WebMCP tools (search_site, list_reading, find_links, get_current_page, get_page_markdown, get_site_index, list_topics, get_connections, cite_current_page, open_page) register when an agent exposes `document.modelContext`.",
          "- No authentication, no rate limits ([auth.md](%s/.well-known/auth.md)). Crawling for search, answers, and training is welcome (robots.txt Content-Signal)." % BASE,
          ""]
lines += ["## Optional", "",
          "- [Tags](%s/tags/): the topic index" % BASE,
          "- [Speaking](%s/speaking/): talks and availability" % BASE,
          "- [Contact](%s/about/#contact): GitHub, LinkedIn, X" % BASE, ""]
open("static/llms.txt", "w").write("\n".join(lines))

full = ["# Raskell: all writing in full", "",
        "> Every published article, review, note, and talk on raskell.io by %s, newest first, then the reading log. "
        "Generated %s. Index: %s/llms.txt" % (AUTHOR, datetime.date.today().isoformat(), BASE), ""]
for a in sorted(articles + notes + talks, key=lambda a: a["date"], reverse=True):
    full += ["", "=" * 80, "", article_markdown(a)]
if works:
    full += ["", "=" * 80, "", "# Reading log", "", "From %s/reading/ (as data: %s/reading.json)." % (BASE, BASE), ""]
    for status, title in SHELVES:
        shelf = sorted([w for w in works if w["status"] == status], key=lambda w: w["finished"], reverse=True)
        if not shelf:
            continue
        full += ["## %s" % title, ""]
        for w in shelf:
            bits = [w["kind"]] + ([str(w["year"])] if w["year"] else []) + (["finished " + month(w["finished"])] if w["finished"] else []) + (["rated %s/10" % w["rating"]] if w["rating"] else [])
            full.append("- *%s*%s by %s (%s)%s%s" % (w["title"], ": " + w["subtitle"] if w["subtitle"] else "", w["author"], ", ".join(bits),
                                                  ". " + w["take"].rstrip(".") if w["take"] else "",
                                                  ". Review: " + REVIEWS[w["id"]]["url"] if w["id"] in REVIEWS else ""))
        full.append("")
open("static/llms-full.txt", "w").write("\n".join(full))

