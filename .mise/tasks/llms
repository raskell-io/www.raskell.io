def translations():
    found = {}
    for path in sorted(glob.glob("content/**/*.md", recursive=True)):
        m = re.match(r"content/(.*?)([^/]+)\.([a-z]{2})\.md$", path)
        if not m or m.group(3) == DEFAULT_LANG or m.group(3) not in [l["code"] for l in LANGS]:
            continue
        folder, name, code = m.groups()
        if name.startswith("taxonomy-tags-") and not folder:
            continue   # generated topic pages (mise run topic-pages); the topics index stands for them
        fm, _ = split_front_matter(open(path).read())
        if re.search(r"^(draft\s*=\s*true|render\s*=\s*false)", fm, re.M):
            continue
        # A translation usually sits beside its English source; a page that exists only in a translated language
        # (the per-language topic and series indexes) has its own path and no source.
        src_path = "content/%s%s.md" % (folder, name)
        src_fm = split_front_matter(open(src_path).read())[0] if os.path.exists(src_path) else ""
        own = fm_str(fm, "path")
        fixed = own[len(code) + 1:] if own and own.startswith(code + "/") else fm_str(src_fm, "path")
        rel = fixed.strip("/") if fixed else (folder.strip("/") if name == "_index" else (folder + name).strip("/"))
        rel = rel + "/" if rel else ""
        lang_desc = re.search(r'^\[languages\.%s\]\n(?:.*\n)*?description\s*=\s*"([^"]*)"' % code, config, re.M)
        found.setdefault(code, []).append({"title": fm_str(fm, "title"), "description": fm_str(fm, "description") or (lang_desc.group(1) if lang_desc else ""),
                                           "url": "%s/%s/%s" % (BASE, code, rel), "source": "%s/%s" % (BASE, rel),
                                           "source_title": fm_str(src_fm, "title") or fm_str(fm, "title")})
    return {l["code"]: found[l["code"]] for l in LANGS if l["code"] in found}

TRANSLATED = translations()
if TRANSLATED:
    names = {l["code"]: l for l in LANGS}
    lines += ["## Translations", "",
              "The site is written in English. Some pages are also translated; a translation lives at the same path under a "
              "language prefix (/zh/about/ translates /about/), carries hreflang alternates, and is linked from its English "
              "page. Articles, reviews, notes, and talks are English only. Each language has a short index of its own.", ""]
    for code, items in TRANSLATED.items():
        l = names[code]
        lines += ["### %s (hreflang `%s`, under /%s/)" % (l.get("name", code), l["hreflang"], code), "",
                  "- [llms.txt in %s](%s/%s/llms.txt)" % (l.get("name", code), BASE, code)]
        lines += ["- [%s](%s): translation of [%s](%s)" % (t["title"], t["url"], t["source_title"], t["source"]) for t in items]
        lines.append("")
    for code, items in TRANSLATED.items():
        l, words = names[code], LLMS_I18N.get(code)
        if not words:
            continue
        out = ["# Raskell (%s)" % l.get("name", code), "", "> " + words["intro"], "", "## " + words["pages"], ""]
        out += ["- [%s](%s): %s%s: %s" % (t["title"], t["url"], t["description"] + " " if t["description"] else "", words["english"], t["source"]) for t in items]
        out += ["", "## English", "", "- [llms.txt](%s/llms.txt): %s" % (BASE, words["index"]), ""]
        os.makedirs("static/%s" % code, exist_ok=True)
        open("static/%s/llms.txt" % code, "w").write("\n".join(out))

lines += ["## For agents", "",
          "- Each article and note as Markdown: its URL with `.md` instead of the trailing slash, e.g. %s/articles/the-model-is-a-dependency.md" % BASE,
          "- Each talk as Markdown too, e.g. %s/talks/iat-13-basel.md" % BASE,
          "- [map.json](%s/map.json): the site graph (articles, notes, talks, topics with definitions, series, categories, works from the reading log, projects, and their links)" % BASE,
          "- [garden.json](%s/garden.json): the search index as data: every article, review, note, talk, work, project, topic, and cited link, with kinds, topics, and dates" % BASE,
          "- [links.json](%s/links.json): every external link the writing cites, with the pages that cite it and whether it is a reference" % BASE,
          "- [reading.json](%s/reading.json): the reading log, with status, dates, ratings, and reviews" % BASE,
          "- Search as a URL: %s/search/?q={query}&type={article|review|note|talk|work|project|topic|link}" % BASE,
