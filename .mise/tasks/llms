# The sources the writing cites most: Markdown links to other sites, counted once per page.
cites = {}
for a in articles + notes + talks:
    seen = set()
    for text, url in re.findall(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", a["body"]):
        key = url.rstrip("/")
        if key.startswith(BASE) or key in seen:
            continue
        seen.add(key)
        c = cites.setdefault(key, {"url": url, "text": text, "pages": 0})
        c["pages"] += 1
top = [c for c in sorted(cites.values(), key=lambda c: (-c["pages"], c["url"])) if c["pages"] > 1][:20]
if top:
    lines += ["## Sources cited most", "", "External links cited on more than one page (all %d are searchable at %s/search/?type=link and listed in [links.json](%s/links.json))." % (len(cites), BASE, BASE), ""]
    lines += ["- [%s](%s): cited on %d pages" % (re.sub(r"[*_`]", "", c["text"]), c["url"], c["pages"]) for c in top]
    lines.append("")

