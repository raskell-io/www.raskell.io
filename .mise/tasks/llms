#!/usr/bin/env python3
#MISE description="Generate llms.txt, llms-full.txt and per-article Markdown copies (static/)"
"""
Answer engines and agents read plain Markdown far more reliably than themed HTML.
This writes, from content/ and data/:

  static/llms.txt              the llms.txt index (https://llmstxt.org): who, what, and every piece of the garden:
                               articles, reviews, notes, talks, the reading log, topics, projects, cited sources
  static/llms-full.txt         every published article, note, and talk in full, newest first, then the reading log
  static/{articles,notes,talks}/<slug>.md  one clean Markdown copy per page, linked from its page head;
                               reviews carry the reviewed work and the rating in their front matter
  static/reading.json          the reading log as data: every work, its status, dates, rating, and review
  static/<lang>/llms.txt       per translation language: a short index, in that language, of the translated pages

Shortcodes become plain fences, internal links become absolute URLs, drafts are skipped.
The outputs are build artefacts (gitignored); CI runs this before `zola build`.
Standard library only, so it runs on the CI runner and on macOS's system Python alike.
"""
import datetime
import glob
import html
import json
import os
import re

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".."))
os.chdir(ROOT)

config = open("config.toml").read()
BASE = re.search(r'^base_url\s*=\s*"([^"]+)"', config, re.M).group(1).rstrip("/")
AUTHOR = re.search(r'^author_full\s*=\s*"([^"]+)"', config, re.M).group(1)
JOB = re.search(r'^job_title\s*=\s*"([^"]+)"', config, re.M).group(1)
SITE_DESC = re.search(r'^description\s*=\s*"([^"]+)"', config, re.M).group(1)


def split_front_matter(text):
    m = re.match(r"\+\+\+\n(.*?)\n\+\+\+\n?(.*)", text, re.S)
    return (m.group(1), m.group(2)) if m else ("", text)


def fm_str(fm, key):
    m = re.search(r'^%s\s*=\s*"((?:[^"\\]|\\.)*)"' % key, fm, re.M)
    return m.group(1).replace('\\"', '"') if m else ""


def fm_list(fm, key):
    m = re.search(r"^%s\s*=\s*\[(.*?)\]" % key, fm, re.M | re.S)
    return re.findall(r'"([^"]+)"', m.group(1)) if m else []


def fm_num(fm, key):
    m = re.search(r"^%s\s*=\s*(\d+(?:\.\d+)?)\s*(#.*)?$" % key, fm, re.M)
    if not m:
        return None
    n = float(m.group(1))
    return int(n) if n.is_integer() else n


def fm_date(fm, key):
    m = re.search(r"^%s\s*=\s*(\d{4}-\d{2}-\d{2})" % key, fm, re.M)
    return m.group(1) if m else ""


def absolute_links(body):
    # @/articles/x.md#anchor -> BASE/articles/x/#anchor, @/about.md -> BASE/about/, /path -> BASE/path
    def at_link(m):
        path = re.sub(r"(_index)?\.md$", "", m.group(1)).strip("/")
        url = "%s/%s/" % (BASE, path) if path else BASE + "/"
        return "](%s%s)" % (url, m.group(2) or "")
    body = re.sub(r"\]\(@/([^)#\s]+?)(#[^)\s]*)?\)", at_link, body)
    body = re.sub(r"\]\((/[^)\s]*)\)", lambda m: "](%s%s)" % (BASE, m.group(1)), body)
    return body


def plain_shortcodes(body):
    # {% diagram(title="...") %} ... {% end %}  and  {% vera() %} ... {% end %}  ->  fenced blocks.
    out, fence, inside = [], False, None
    for line in body.split("\n"):
        stripped = line.strip()
        if inside is None and stripped.startswith("```"):
            fence = not fence
        if not fence:
            m = re.match(r'\{%\s*(diagram|vera)\((.*?)\)\s*%\}\s*$', stripped)
            if m and inside is None:
                title = re.search(r'title\s*=\s*"([^"]*)"', m.group(2))
                if title:
                    out.append("*%s*" % title.group(1))
                    out.append("")
                out.append("```" + ("text" if m.group(1) == "diagram" else "vera"))
                inside = m.group(1)
                continue
            if inside and re.match(r"\{%\s*end\s*%\}\s*$", stripped):
                out.append("```")
                inside = None
                continue
        out.append(line)
    return "\n".join(out)


def slides_to_markdown(body):
    # Talks are slide decks written as HTML sections: keep the words, one heading per slide.
    text = re.sub(r"<(script|style)\b.*?</\1>", "", body, flags=re.S)
    text = re.sub(r"<h1[^>]*>(.*?)</h1>", lambda m: "\n\n## " + m.group(1) + "\n\n", text, flags=re.S)
    text = re.sub(r"<h[23][^>]*>(.*?)</h[23]>", lambda m: "\n\n### " + m.group(1) + "\n\n", text, flags=re.S)
    text = re.sub(r"<li[^>]*>", "\n- ", text)
    text = re.sub(r"</(p|li|div|section|blockquote|figcaption)>", "\n", text)
    text = re.sub(r"<br\s*/?>", "\n", text)
    text = re.sub(r'<a [^>]*href="([^"]+)"[^>]*>(.*?)</a>', lambda m: "[%s](%s)" % (re.sub(r"<[^>]+>", "", m.group(2)).strip(), m.group(1)), text, flags=re.S)
    text = html.unescape(re.sub(r"<[^>]+>", "", text))
    lines = [re.sub(r"[ \t]+", " ", l).strip() for l in text.split("\n")]
    # Slide numbers and separator dots carry nothing in text; a bullet whose text sits on the next line joins it.
    lines = [l for l in lines if not re.fullmatch(r"\d{1,3}|[·•|/]", l)]
    out = []
    for l in lines:
        if out and out[-1] == "-" and l:
            out[-1] = "- " + l
        elif not (l == "" and out and out[-1] == "-"):
            out.append(l)
    return re.sub(r"\n{3,}", "\n\n", "\n".join(l for l in out if l != "-")).strip()


def load(section):
    out = []
    for path in glob.glob("content/%s/*.md" % section):
        if path.endswith("_index.md"):
            continue
        # Translations (<slug>.<lang>.md) are copies of a page in another language, not pages of their own.
        if re.search(r"\.[a-z]{2}\.md$", path):
            continue
        fm, body = split_front_matter(open(path).read())
        if re.search(r"^draft\s*=\s*true", fm, re.M):
            continue
        slug = fm_str(fm, "slug") or os.path.basename(path)[:-3]
        out.append(entry(section, slug, fm, body))
    out.sort(key=lambda a: a["date"], reverse=True)
    return out


def entry(section, slug, fm, body):
    return {
        "slug": slug,
        "title": fm_str(fm, "title"),
        "date": fm_date(fm, "date"),
        "updated": fm_date(fm, "updated"),
        "description": fm_str(fm, "description"),
        "tags": fm_list(fm, "tags"),
        "series": fm_list(fm, "series"),
        "categories": fm_list(fm, "categories"),
        "review": fm_str(fm, "review"),
        "reads": fm_list(fm, "reads"),
        "in_short": fm_list(fm, "in_short"),
        "event": fm_str(fm, "event"),
        "venue": fm_str(fm, "venue"),
        "section": section,
        "url": "%s/%s/%s/" % (BASE, section, slug),
        "md": "%s/%s/%s.md" % (BASE, section, slug),
        "body": slides_to_markdown(body) if section == "talks" else plain_shortcodes(absolute_links(body.strip())),
    }


articles = load("articles")
notes = load("notes") if os.path.isdir("content/notes") else []
talks = load("talks") if os.path.isdir("content/talks") else []


def parse_works():
    # data/reading.toml, parsed by hand like the vocabulary (no tomllib on older Pythons): [[works]] blocks.
    if not os.path.exists("data/reading.toml"):
        return []
    out = []
    for block in re.split(r"^\[\[works\]\]\s*$", open("data/reading.toml").read(), flags=re.M)[1:]:
        w = {k: fm_str(block, k) for k in ("id", "title", "subtitle", "author", "kind", "edition", "publisher", "isbn",
                                          "url", "status", "started", "finished", "about", "take", "cover")}
        w["year"], w["rating"], w["topics"] = fm_num(block, "year"), fm_num(block, "rating"), fm_list(block, "topics")
        out.append(w)
    return out


WORKS = {w["id"]: w for w in parse_works()}
REVIEWS = {a["review"]: a for a in articles + notes if a["review"]}


def month(ym):
    # "2025-07" -> "July 2025"; a year alone stays a year.
    if len(ym) == 4:
        return ym
    return datetime.datetime.strptime(ym, "%Y-%m").strftime("%B %Y") if ym else ""


def article_markdown(a):
    head = ["---", 'title: "%s"' % a["title"].replace('"', '\\"'), "url: %s" % a["url"], "author: %s" % AUTHOR,
            "date: %s" % a["date"]]
    if a["updated"]:
        head.append("updated: %s" % a["updated"])
    head.append('description: "%s"' % a["description"].replace('"', '\\"'))
    if a["tags"]:
        head.append("tags: [%s]" % ", ".join(a["tags"]))
    if a["series"]:
        head.append("series: %s" % a["series"][0])
    if a["categories"]:
        head.append("categories: [%s]" % ", ".join(a["categories"]))
    w = WORKS.get(a["review"])
    if w:
        head.append('review_of: "%s"' % w["title"].replace('"', '\\"'))
        head.append('review_of_author: "%s"' % w["author"].replace('"', '\\"'))
        head.append("review_of_kind: %s" % w["kind"])
        if w["year"]:
            head.append("review_of_year: %d" % w["year"])
        if w["rating"]:
            head.append("rating: %s/10" % w["rating"])
    if a["event"]:
        head.append('event: "%s"' % a["event"].replace('"', '\\"'))
    if a["venue"]:
        head.append('venue: "%s"' % a["venue"].replace('"', '\\"'))
    head += ["---", "", "# " + a["title"], ""]
    if a["in_short"]:
        head += ["## In short", "", " ".join(a["in_short"]), ""]
    head += [a["body"], ""]
    return "\n".join(head)


for section, items in (("articles", articles), ("notes", notes), ("talks", talks)):
    os.makedirs("static/%s" % section, exist_ok=True)
    for old in glob.glob("static/%s/*.md" % section):
        os.remove(old)
    for a in items:
        with open("static/%s/%s.md" % (section, a["slug"]), "w") as f:
            f.write(article_markdown(a))


# The topic vocabulary (data/tags.toml), read with a small parser so this runs on any Python 3.
def vocabulary():
    entries, cur = [], None
    for line in open("data/tags.toml"):
        m = re.match(r"^\[([a-z0-9-]+)\]\s*$", line)
        if m:
            cur = {"slug": m.group(1), "broader": []}
            entries.append(cur)
            continue
        m = re.match(r'^(name|kind|description)\s*=\s*"(.*)"\s*$', line)
        if cur and m:
            cur[m.group(1)] = m.group(2)
        m = re.match(r"^broader\s*=\s*\[(.*)\]", line)
        if cur and m:
            cur["broader"] = re.findall(r'"([^"]+)"', m.group(1))
    return entries


def projects_from(section):
    fm, _ = split_front_matter(open("content/%s/_index.md" % section).read())
    rows = []
    for tier in re.finditer(r'\{[^{}]*?title = "([^"]+)"[^{}]*?projects = \[([^\]]*)\][^{}]*\}', fm, re.S):
        for slug in re.findall(r'"([^"]+)"', tier.group(2)):
            data = open("data/projects/%s.toml" % slug).read()
            url = re.search(r'url = "([^"]+)"', data)
            desc = fm_str(data, "description")
            first = re.split(r"(?<=[.!?])\s", desc, maxsplit=1)[0]
            rows.append((fm_str(data, "title"), url.group(1) if url else "%s/%s/" % (BASE, section), first, tier.group(1)))
    return rows


